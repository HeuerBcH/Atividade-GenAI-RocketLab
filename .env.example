# Copie para `.env` e preencha. O `.env` NUNCA deve ser versionado.

# Provedor de LLM: groq (padrão) ou openrouter
LLM_PROVIDER=groq

# Chave do Groq (https://console.groq.com/keys), começa com gsk_
GROQ_API_KEY=

# Chave do OpenRouter (https://openrouter.ai/keys), começa com sk-or-v1-
# Necessária só se LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Caminho do banco SQLite da camada Gold (relativo à raiz do projeto ou absoluto)
DB_PATH=data/cinerocket.db

# Modelo (ou cadeia de fallback separada por vírgulas); vazio = padrão do provedor
MODEL_NAME=openai/gpt-oss-120b

# URL da API compatível com OpenAI; vazio = padrão do provedor
MODEL_BASE_URL=https://api.groq.com/openai/v1

# Tempo máximo, em segundos, para responder uma pergunta inteira
QUESTION_TIMEOUT_SECONDS=180

# Opcionais:
# TEMPERATURE=0
# REASONING_EFFORT=none       # none | low | medium | high
# MAX_REQUESTS_PER_QUESTION=10
# MODEL_TIMEOUT_SECONDS=90    # tempo máximo de uma chamada ao LLM
# QUERY_TIMEOUT_SECONDS=30    # tempo máximo de uma consulta SQL
# MAX_ROWS=1000               # teto de linhas devolvidas por consulta
# CORS_ORIGINS=http://localhost:5173  # origens do frontend, separadas por vírgula
